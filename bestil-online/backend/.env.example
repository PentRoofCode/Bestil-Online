NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgresql://bestil:your-postgres-password@localhost:5432/bestil_dev
REDIS_URL=redis://:your-redis-password@localhost:6379

JWT_SECRET=replace-with-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=DKK

VAT_RATE=0.25
DEFAULT_COMMISSION_RATE=0.15

# Optional: admin API key for server-to-server calls (min 16 chars)
# API_KEY=

# Email — defaults to console logging in dev. Set SMTP_HOST to send real emails.
# EMAIL_FROM=no-reply@bestil.online
# FRONTEND_URL=http://localhost:5173
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
